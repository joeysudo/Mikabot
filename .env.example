# Copy to .dev.vars for local Workers runtime; never commit real values.
# Local planning works without secrets. Real connections require all security fields.
APP_ORIGIN=
WORKSPACE_PASSWORD=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
META_CLIENT_ID=
META_CLIENT_SECRET=
META_API_VERSION=v26.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202603
X_CLIENT_ID=
X_CLIENT_SECRET=
# AI is optional; Gemini is preferred when configured. No key is committed.
GEMINI_API_KEY=
# Use vertex-express for an Agent Platform Express Mode key.
GEMINI_BACKEND=gemini-api
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=
# Communication adapters: deployment secrets, not fields in the public UI.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
WHATSAPP_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Set only after deploying the separate scheduled Worker successfully.
AGENT_SCHEDULER_ENABLED=false
